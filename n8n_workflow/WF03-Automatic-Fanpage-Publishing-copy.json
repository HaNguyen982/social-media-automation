    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst content = $json;\n\n// Chỉ cho phép bài chào mừng đã được duyệt.\nconst ALLOWED_CONTENT_ID = '6af7aa1042f67c441f7e71ed';\n\nconst isValid =\n  typeof content._id === 'string' &&\n  content._id === ALLOWED_CONTENT_ID &&\n  typeof content.title === 'string' &&\n  content.title.trim().length > 0 &&\n  typeof content.body === 'string' &&\n  content.body.trim().length > 0 &&\n  content.status === 'APPROVED' &&\n  content.reviewStatus === 'HUMAN_APPROVED' &&\n  content.requiresHumanReview === false &&\n  content.medicalReview?.decision === 'APPROVED' &&\n  !content.facebookPostId &&\n  !content.publishedAt;\n\nif (!isValid) {\n  throw new Error(\n    'Publishing validation failed: content is not eligible for this live test.'\n  );\n}\n\nreturn {\n  json: {\n    ...content,\n    isValid: true,\n    validationMessage: 'Approved welcome post validated',\n    publishingMode: 'SIMULATION',\n  },\n};\n"
      },
