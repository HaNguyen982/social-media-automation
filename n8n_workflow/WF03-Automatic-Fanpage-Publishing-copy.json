        "jsonBody": "=\n{{\n  JSON.stringify({\n    query: `mutation {\n      createPost(input: {\n        channelId: \"6af5ae0462b70b94b0071815\",\n        text: ${JSON.stringify($('Prepare Facebook Post').first().json.postMessage)},\n        assets: [],\n        metadata: { facebook: { type: post } },\n        mode: shareNow,\n        schedulingType: automatic,\n        needsApproval: false\n      }) {\n        __typename\n        ... on PostActionSuccess {\n          post {\n            id\n            status\n            text\n            sentAt\n            externalLink\n          }\n        }\n        ... on InvalidInputError {\n          message\n        }\n      }\n    }`\n  })\n}}\n",
