        "jsCode": "\nconst post = $json;\n\nconst simulatedPostId = `SIMULATED_${Date.now()}`;\n\nreturn {\n  json: {\n    ...post,\n\n    // Mô phỏng đăng thành công\n    publishSuccess: true,\n    publishingStatus: 'SIMULATED',\n\n    // ID giả lập, không phải ID Facebook thật\n    simulatedPostId: simulatedPostId,\n\n    // Không ghi nhận đã đăng Facebook thật\n    facebookPostId: null,\n    publishedAt: null,\n\n    simulatedAt: new Date().toISOString(),\n\n    publishingMessage:\n      'Simulation successful. No post was sent to Facebook.',\n\n    logMessage:\n      'Simulation successful. No post was sent to Facebook.'\n  }\n};\n"
