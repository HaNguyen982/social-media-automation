    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items || items.length === 0) {\n  return [{\n    json: {\n      isValid: false,\n      error: 'EMPTY_PAYLOAD',\n      message: 'Không nhận được dữ liệu payload trong yêu cầu.',\n      contentId: null\n    }\n  }];\n}\n\nconst raw = items[0].json;\nconst body = raw.body || raw;\nconst contentIdRaw = body.contentId;\nconst MONGO_ID_REGEX = /^[0-9a-fA-F]{24}$/;\n\nif (!contentIdRaw || typeof contentIdRaw !== 'string' || !MONGO_ID_REGEX.test(contentIdRaw.trim())) {\n  return [{\n    json: {\n      isValid: false,\n      error: 'INVALID_CONTENT_ID',\n      message: 'ID bài viết không hợp lệ hoặc thiếu (yêu cầu định dạng MongoDB ObjectId 24 ký tự hex).',\n      contentId: contentIdRaw || null\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    isValid: true,\n    contentId: contentIdRaw.trim(),\n    receivedAt: new Date().toISOString()\n  }\n}];\n"
      },
