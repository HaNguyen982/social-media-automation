      "name": "Get Content By ID",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items || items.length === 0 || items[0].json.error) {\n  throw new Error('Không thể tải thông tin bài viết từ NestJS backend.');\n}\n\nconst content = items[0].json;\nconst expectedContentId = $('Prepare Publishing Request').first().json.contentId;\nconst publishingMode = $('Prepare Publishing Request').first().json.publishingMode || 'SIMULATION';\n\nif (!content || !content._id || content._id !== expectedContentId) {\n  throw new Error(`Content ID mismatch. Expected: ${expectedContentId}, received: ${content?._id}`);\n}\n\nif (content.status !== 'APPROVED') {\n  throw new Error(`Content ${content._id} is not APPROVED (current: ${content.status}).`);\n}\n\nif (content.reviewStatus && content.reviewStatus !== 'HUMAN_APPROVED') {\n  throw new Error(`Content ${content._id} has not been approved by human reviewer.`);\n}\n\nif (content.requiresHumanReview === true) {\n  throw new Error(`Content ${content._id} still requires human review.`);\n}\n\nif (content.medicalReview?.decision && content.medicalReview.decision !== 'APPROVED') {\n  throw new Error(`Content ${content._id} did not pass medical review.`);\n}\n\nif (content.facebookPostId || content.publishedAt) {\n  throw new Error(`Content ${content._id} has already been published to Facebook.`);\n}\n\nif (content.reconciliationStatus === 'NEEDS_MANUAL_REVIEW') {\n  throw new Error(`Content ${content._id} is marked NEEDS_MANUAL_REVIEW. Check Buffer/Facebook before publishing.`);\n}\n\nif (typeof content.title !== 'string' || content.title.trim().length === 0) {\n  throw new Error(`Content ${content._id} has empty title.`);\n}\n\nif (typeof content.body !== 'string' || content.body.trim().length === 0) {\n  throw new Error(`Content ${content._id} has empty body.`);\n}\n\nreturn [{\n  json: {\n    ...content,\n    isValid: true,\n    validationMessage: `Dynamic content ${content._id} validated successfully`,\n    publishingMode: publishingMode\n  }\n}];\n"
      },
