      "credentials": {
        "httpHeaderAuth": {
          "id": "lCrttaVO0mZoiSRS",
          "name": "Header Auth account 3"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'http://host.docker.internal:3000/api/contents/' + $json.contentId + '/reject' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    reviewer: \"HUMAN_REVIEWER\",\n    reviewMessage: \"Bài viết chưa đáp ứng yêu cầu kiểm duyệt.\"\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1952,
        208
      ],
      "id": "54995b66-d5da-418b-8969-470cc711e46f",
      "name": "Reject Content",
      "credentials": {
        "httpHeaderAuth": {
          "id": "lCrttaVO0mZoiSRS",
          "name": "Header Auth account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rawId = $json[\"Content ID\"] ?? $json.contentId;\nconst contentId = String(rawId ?? \"\").trim();\n\nif (!/^[a-fA-F0-9]{24}$/.test(contentId)) {\n  throw new Error(\"Content ID không hợp lệ\");\n}\n\nreturn {\n  json: {\n    contentId\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        240
      ],
      "id": "890001bf-9846-4046-94a1-e192bdc17263",
      "name": "Normalize Content ID"
    },
    {
      "parameters": {
        "jsCode": "const content = $json;\n\nconst errors = [];\n\nif (!content._id) {\n  errors.push(\"Không tìm thấy ID bài viết\");\n}\n\nif (!content.title || typeof content.title !== \"string\") {\n  errors.push(\"Tiêu đề bài viết không hợp lệ\");\n}\n\nif (!content.topic || typeof content.topic !== \"string\") {\n  errors.push(\"Chủ đề bài viết không hợp lệ\");\n}\n\nif (!content.body || typeof content.body !== \"string\") {\n  errors.push(\"Nội dung bài viết không hợp lệ\");\n}\n\nconst allowedStatuses = [\n  \"PENDING_REVIEW\",\n  \"APPROVED\",\n  \"REJECTED\"\n];\n\nif (!allowedStatuses.includes(content.status)) {\n  errors.push(\"Trạng thái bài viết không hợp lệ\");\n}\n\nif (errors.length > 0) {\n  throw new Error(\n    \"Dữ liệu bài viết không hợp lệ: \" + errors.join(\"; \")\n  );\n}\n\nreturn {\n  json: {\n    ...content,\n    retrievedContentValid: true\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        240
      ],
      "id": "5b99ba9f-6b86-450b-831f-a735b46da984",
      "name": "Validate Retrieved Content"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "8c8d2f44-9f4b-4aaa-8054-936ca154b5c5",
              "name": "contentId",
              "value": "={{ $json._id }}",
              "type": "string"
            },
            {
              "id": "80665239-4828-49ec-bd15-877303fa836c",
              "name": "title",
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "54dc5789-a154-4db3-b42a-8b1d5f049375",
              "name": "body",
              "value": "={{ $json.body }}",
              "type": "string"
            },
            {
              "id": "6d899f5a-13a5-46c9-9379-997b36fdb19c",
              "name": "aiDecision",
              "value": "={{ $json.medicalReview?.decision || \"NOT_REVIEWED\" }}",
              "type": "string"
            },
            {
              "id": "d6407b1e-3fd0-424c-9c1f-6ee5c9afced0",
              "name": "aiExplanation",
              "value": "={{ $json.medicalReview?.explanation || \"\" }}",
              "type": "string"
            },
            {
              "id": "0a043c6b-f50a-49ea-b9a7-32ba0317bbae",
              "name": "topic",
              "value": "={{ $json.topic }}",
              "type": "string"
            },
            {
              "id": "a54ed87a-d380-4e83-8896-70fb5f14bfbe",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        928,
        112
      ],
      "id": "e8c3c252-389d-4ed6-80cd-f04666252ef9",
      "name": "Prepare Review Display Data"
    },
    {
      "parameters": {
        "jsCode": "const decision = String($json.humanDecision ?? \"\")\n  .trim()\n  .toUpperCase();\n\nif (![\"APPROVE\", \"REJECT\"].includes(decision)) {\n  throw new Error(\n    \"Quyết định kiểm duyệt không hợp lệ. Chỉ chấp nhận APPROVE hoặc REJECT.\"\n  );\n}\n\nreturn {\n  json: {\n    ...$json,\n    humanDecision: decision\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        112
      ],
      "id": "a024e96c-3bd0-4c01-9a1e-58d4638688cc",
      "name": "Validate Human Decision"
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    success: false,\n    message: \"Bài viết không ở trạng thái chờ kiểm duyệt.\",\n    contentId: $json._id || \"\",\n    currentStatus: $json.status || \"UNKNOWN\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        352
      ],
      "id": "84a96de4-778b-439b-97e4-514c1d377090",
      "name": "Handle Non-Pending Content"
    }
