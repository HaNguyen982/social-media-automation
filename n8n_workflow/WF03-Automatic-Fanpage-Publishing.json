    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [];\n}\n\nconst eligibleItems = items.filter(item => {\n  const content = item.json;\n\n  return (\n    content.status === 'APPROVED' &&\n    content.reviewStatus === 'HUMAN_APPROVED' &&\n    content.requiresHumanReview === false &&\n    content.medicalReview?.decision === 'APPROVED' &&\n    !content.facebookPostId &&\n    !content.publishedAt &&\n    typeof content._id === 'string' &&\n    content._id.length > 0\n  );\n});\n\nif (eligibleItems.length === 0) {\n  return [];\n}\n\nreturn [eligibleItems[0]];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        96
      ],
      "id": "8eb45d25-feb9-4bbd-a2c7-685caa72717a",
      "name": "Select Content to Publish"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst content = $json;\n\nconst isValid =\n  typeof content._id === 'string' &&\n  /^[a-fA-F0-9]{24}$/.test(content._id) &&\n  typeof content.title === 'string' &&\n  content.title.trim().length > 0 &&\n  typeof content.body === 'string' &&\n  content.body.trim().length > 0 &&\n  content.status === 'APPROVED' &&\n  content.reviewStatus === 'HUMAN_APPROVED' &&\n  content.requiresHumanReview === false;\n\nif (!isValid) {\n  throw new Error(\n    'Publishing validation failed: content is missing required fields or has not been approved by a human reviewer.'\n  );\n}\n\nreturn {\n  json: {\n    ...content,\n    isValid: true,\n    validationMessage: 'Content is valid for publishing',\n  },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
