    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\nconst result = response.data?.createPost;\n\nif (\n  result?.__typename !== 'PostActionSuccess' ||\n  result?.post?.status !== 'sent'\n) {\n  throw new Error('Buffer has not confirmed the post as sent.');\n}\n\nconst originalContent = $('Prepare Facebook Post').first().json;\n\nif (!originalContent.contentId) {\n  throw new Error('Missing original contentId.');\n}\n\nconst post = result.post;\n\nif (!post.id || !post.sentAt || !post.externalLink) {\n  throw new Error('Missing Buffer post information.');\n}\n\n// Trích xuất Facebook Post ID từ URL\nconst match = post.externalLink.match(\n  /facebook\\.com\\/(\\d+_\\d+)(?:[/?#]|$)/\n);\n\nif (!match) {\n  throw new Error('Cannot extract Facebook Post ID from URL.');\n}\n\nreturn [\n  {\n    json: {\n      contentId: originalContent.contentId,\n      bufferPostId: post.id,\n      facebookPostId: match[1],\n      facebookPostUrl: post.externalLink,\n      publishingMode: 'LIVE',\n      publishingStatus: 'SENT',\n      publishedAt: post.sentAt,\n      postMessage: originalContent.postMessage\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
